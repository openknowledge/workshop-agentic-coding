{
  "name": "customer-management-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write \"{src,tests,e2e}/**/*.{ts,tsx,css,json}\" \"*.ts\"",
    "prettier:check": "prettier --check \"{src,tests,e2e}/**/*.{ts,tsx,css,json}\" \"*.ts\"",
    "preview": "vite preview",
    "test": "playwright test",
    "test:dev": "cross-env PLAYWRIGHT_SKIP_DOCKER=true playwright test",
    "test:ui": "playwright test --ui",
    "test:ui:dev": "cross-env PLAYWRIGHT_SKIP_DOCKER=true playwright test --ui",
    "test:report": "playwright show-report",
    "test:unit": "vitest run",
    "test:unit:coverage": "cross-env VITE_COVERAGE=true vitest run",
    "pretest:e2e:coverage": "playwright install chromium",
    "test:e2e:coverage": "cross-env PLAYWRIGHT_COVERAGE=true playwright test",
    "test:e2e:coverage:dev": "cross-env PLAYWRIGHT_SKIP_DOCKER=true PLAYWRIGHT_COVERAGE=true playwright test",
    "test:coverage:report": "nyc report",
    "coverage:clean": "rimraf .nyc_output",
    "test:coverage": "npm run coverage:clean && npm run test:unit:coverage && npm run test:e2e:coverage && npm run test:coverage:report",
    "test:coverage:check": "nyc check-coverage"
  },
  "nyc": {
    "branches": 95,
    "lines": 95,
    "functions": 95,
    "statements": 95
  },
  "dependencies": {
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.166.2",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-istanbul": "^4.1.7",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^25.0.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "testcontainers": "^12.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-istanbul": "^9.0.0",
    "vitest": "^4.0.0"
  }
}
